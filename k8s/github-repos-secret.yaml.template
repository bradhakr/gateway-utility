# ─────────────────────────────────────────────────────────────────────────────
# github-repos-secret.yaml.template — GitHub Repository Configuration Secret
#
# SAFE TO COMMIT — all values are placeholders.
#
# This secret holds github-repos.json, which stores the GitHub repository
# entries (owner, repo name, branch, PAT) used by the Repository SyncUp tool.
# It is OPTIONAL — the pod starts and runs normally without it; Repository
# SyncUp will simply show "no repositories configured".
#
# HOW TO USE:
#   1. Copy this file:
#        cp k8s/github-repos-secret.yaml.template k8s/github-repos-secret.yaml
#   2. Fill in your real GitHub owner, repo, branch, and PAT values in
#      github-repos-secret.yaml.  Add or remove repo entries as needed.
#   3. Apply to the cluster:
#        kubectl apply -f k8s/github-repos-secret.yaml -n gu-dev
#        kubectl apply -f k8s/github-repos-secret.yaml -n gu-prod
#   4. Restart the pod to pick up the new secret:
#        kubectl rollout restart deployment/gateway-utility -n gu-dev
#        kubectl rollout restart deployment/gateway-utility -n gu-prod
#   5. Never commit github-repos-secret.yaml — it is in .gitignore
#
# ALTERNATIVE (recommended for CI/CD — no YAML editing needed):
#   kubectl create secret generic gateway-utility-github-repos \
#     --namespace gu-dev \
#     --from-file=github-repos.json=/path/to/your/github-repos.json \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# PAT SCOPE REQUIREMENTS:
#   Classic PAT  — repo scope (full repository read/write)
#   Fine-grained — Repository permissions → Contents: Read and write
#
# NOTE — READ-ONLY IN KUBERNETES:
#   In a Kubernetes deployment this file is mounted read-only from the secret.
#   The GitHub Config UI page (/github-config) will return an error if you
#   try to save changes through the browser while running in-cluster.
#   Manage repository entries by editing this secret directly and restarting
#   the pod, exactly as you would for graphman.configuration.
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: gateway-utility-github-repos
  namespace: gu-dev          # Change to gu-prod for production
  labels:
    app.kubernetes.io/name: gateway-utility
    app.kubernetes.io/component: credentials
type: Opaque
stringData:
  github-repos.json: |
    {
      "repositories": [
        {
          "name": "<display-name>",
          "owner": "<github-owner-or-org>",
          "repo": "<repository-name>",
          "branch": "main",
          "pat": "<your-github-personal-access-token>",
          "description": "<optional free-text description>"
        }
      ]
    }
