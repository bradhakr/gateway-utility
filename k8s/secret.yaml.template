# ─────────────────────────────────────────────────────────────────────────────
# secret.yaml.template — graphman.configuration Secret
#
# SAFE TO COMMIT — all values are placeholders.
#
# HOW TO USE:
#   1. Copy this file:
#        cp k8s/secret.yaml.template k8s/secret.yaml
#   2. Fill in your real gateway address, username, and password in secret.yaml
#   3. Apply to the cluster:
#        kubectl apply -f k8s/secret.yaml -n gu-dev
#        kubectl apply -f k8s/secret.yaml -n gu-prod
#   4. Never commit secret.yaml — it is in .gitignore
#
# ALTERNATIVE (recommended for CI/CD — no YAML editing needed):
#   kubectl create secret generic gateway-utility-graphman \
#     --namespace gu-dev \
#     --from-file=graphman.configuration=/path/to/your/graphman.configuration \
#     --dry-run=client -o yaml | kubectl apply -f -
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: gateway-utility-graphman
  namespace: gu-dev          # Change to gu-prod for production
  labels:
    app.kubernetes.io/name: gateway-utility
    app.kubernetes.io/component: credentials
type: Opaque
stringData:
  graphman.configuration: |
    {
      "gateways": {
        "default": {
            "address": "https://<your-gateway-host>:443/graphman",
            "username": "<your-username>",
            "password": "<your-password>",
            "rejectUnauthorized": false,
            "keyFilename": null,
            "certFilename": null,
            "passphrase": "<your-passphrase>",
            "allowMutations": true
        },
        "source": {
            "address": "https://<your-source-gateway-host>:443/graphman",
            "username": "<your-username>",
            "password": "<your-password>",
            "rejectUnauthorized": false,
            "keyFilename": null,
            "certFilename": null,
            "passphrase": "<your-passphrase>",
            "allowMutations": true
        },
        "target": {
            "address": "https://<your-target-gateway-host>:443/graphman",
            "username": "<your-username>",
            "password": "<your-password>",
            "rejectUnauthorized": false,
            "keyFilename": null,
            "certFilename": null,
            "passphrase": "<your-passphrase>",
            "allowMutations": true
        }
      },
      "options": {
        "log": "info",
        "schema": "v11.2.1",
        "policyCodeFormat": "code",
        "keyFormat": "p12",
        "extensions": [
          "pre-request",
          "post-export",
          "pre-import",
          "post-revise",
          "multiline-text-diff",
          "policy-code-validator"
        ]
      }
    }
