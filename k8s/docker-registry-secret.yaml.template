# ─────────────────────────────────────────────────────────────────────────────
# docker-registry-secret.yaml.template — Docker Hub pull secret
#
# SAFE TO COMMIT — contains no real credentials.
#
# HOW TO USE:
#   Generate the secret directly from your Docker Hub credentials:
#
#   kubectl create secret docker-registry private-registry-secret \
#     --docker-server=docker.io \
#     --docker-username=<your-dockerhub-username> \
#     --docker-password=<your-dockerhub-pat> \
#     --docker-email=<your-email> \
#     --namespace gu-dev \
#     --dry-run=client -o yaml | kubectl apply -f -
#
#   Repeat with --namespace gu-prod for production.
#
# PERSONAL ACCESS TOKEN:
#   Create a Docker Hub PAT at:
#   https://hub.docker.com → Account Settings → Security → New Access Token
#   Use Read-only scope for pull-only access.
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: private-registry-secret
  namespace: gu-dev          # Change to gu-prod for production
type: kubernetes.io/dockerconfigjson
data:
  # Generate this value with:
  #   kubectl create secret docker-registry private-registry-secret \
  #     --docker-server=docker.io \
  #     --docker-username=<username> \
  #     --docker-password=<pat> \
  #     --docker-email=<email> \
  #     --dry-run=client -o yaml
  .dockerconfigjson: <BASE64_ENCODED_DOCKER_CONFIG>
